# =============================================================
# MarketGuard — Complete Environment Configuration
# Copy ALL values below to your deployment platform
# =============================================================

# --- LLM Mode ---
LLM_MODE=cloud

# --- Gemini API (Gemma) ---
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMMA_MODEL=gemma-2.5-flash

# --- Speech-to-Text ---
STT_MODE=local

# --- Database (Supabase) ---
USE_SQLITE=false
SUPA_PASS=YOUR_SUPABASE_PASSWORD_HERE
SUPA_HOST=db.YOUR_PROJECT_REF.supabase.co
SUPA_PORT=5432
SUPA_DB=postgres
SUPA_USER=postgres

# --- Auth ---
# Generate at: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=YOUR_JWT_SECRET_HERE
