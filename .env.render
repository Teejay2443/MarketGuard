# =============================================================
# MarketGuard — Render Deployment (merged env)
# Set these as Environment Variables in Render dashboard
# =============================================================

# --- Mode ---
# cloud = Gemini API (online, recommended for production)
# local = Ollama (offline, for local dev only)
LLM_MODE=cloud

# --- Gemini API Key (Gemma) ---
# Get yours free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Gemma Model ---
GEMMA_MODEL=gemma-2.5-flash

# --- Speech-to-Text ---
# cloud = Google Cloud STT (supports Yoruba, Hausa, Pidgin)
# local = faster-whisper (offline, no key needed)
STT_MODE=local
# Only needed if STT_MODE=cloud:
# GOOGLE_STT_API_KEY=your_google_stt_key

# --- Database ---
# Render provides a free PostgreSQL database, OR use Supabase
# Option A: Render PostgreSQL (set these after creating a database in Render)
# DATABASE_URL=postgres://user:pass@host:5432/marketguard

# Option B: Supabase
USE_SQLITE=false
SUPA_PASS=your_supabase_password_here
SUPA_HOST=db.xxxxx.supabase.co
SUPA_PORT=5432
SUPA_DB=postgres
SUPA_USER=postgres

# --- Auth Secret ---
# Generate a random string at: https://www.random.org/strings/
JWT_SECRET=your_random_secret_key_here_at_least_32_chars
