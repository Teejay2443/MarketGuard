# Vercel Backend Deployment (serverless)
# Set these in Vercel dashboard → Settings → Environment Variables

# --- Mode ---
LLM_MODE=cloud

# --- Gemini API (Gemma) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=gemma-2.5-flash

# --- Database (Supabase) ---
USE_SQLITE=false
SUPA_PASS=your_supabase_password_here
SUPA_HOST=db.xxxxx.supabase.co
SUPA_PORT=5432
SUPA_DB=postgres
SUPA_USER=postgres

# --- Auth ---
JWT_SECRET=your_random_secret_key_here

# --- Cloud STT ---
STT_MODE=cloud
GOOGLE_STT_API_KEY=your_google_stt_api_key_here
