# MarketGuard — Environment Configuration

# --- LLM Mode ---
LLM_MODE=cloud

# --- Gemini API (Gemma) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=gemma-2.5-flash

# --- Speech-to-Text ---
STT_MODE=local

# --- Database (Supabase) ---
# Use port 6543 (pooler) for IPv4-compatible hosting (Render, Railway, etc.)
USE_SQLITE=false
SUPA_PASS=your_supabase_password
SUPA_HOST=db.xxxxx.supabase.co
SUPA_PORT=6543
SUPA_DB=postgres
SUPA_USER=postgres

# --- Auth ---
JWT_SECRET=your_random_secret_key
