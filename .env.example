# =============================================================
# MarketGuard — Environment Configuration
# =============================================================

# --- LLM Mode ---
# "cloud" = Gemini API (online, needs GEMINI_API_KEY)
# "local" = Ollama (offline, no key needed)
LLM_MODE=cloud

# --- Gemini API Key (for Gemma) ---
# Get yours free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=gemma-2.5-flash

# --- Speech-to-Text ---
# "cloud" = Google Cloud STT (Nigerian languages)
# "local" = faster-whisper (offline)
STT_MODE=local

# --- Database ---
# "true" = SQLite (local, no setup)
# "false" = PostgreSQL (needs connection details)
USE_SQLITE=true

# Supabase PostgreSQL (when USE_SQLITE=false)
SUPA_PASS=your_supabase_password
SUPA_HOST=db.xxxxx.supabase.co
SUPA_PORT=5432
SUPA_DB=postgres
SUPA_USER=postgres

# --- Auth ---
JWT_SECRET=your_random_secret_key_here
