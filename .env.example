# --- Mode ---
# Set to "local" (Ollama) or "cloud" (Gemini API)
LLM_MODE=local

# --- Cloud (required if LLM_MODE=cloud) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=gemma-4-31b-it

# --- Database ---
# Option A: Use SQLite (default, no setup needed)
USE_SQLITE=true

# Option B: Use Supabase PostgreSQL
# Set USE_SQLITE=false and provide connection details
# USE_SQLITE=false
# SUPA_PASS=your_database_password
# SUPA_HOST=db.xxxxx.supabase.co
# SUPA_PORT=5432
# SUPA_DB=postgres
# SUPA_USER=postgres

# Option C: Standard PostgreSQL via DATABASE_URL
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Option D: Individual PostgreSQL params
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=marketguard
# DB_USER=postgres
# DB_PASS=postgres

# --- Auth ---
JWT_SECRET=change-this-to-a-random-secret-key
