# MarketGuard Environment Configuration
# Copy to .env and fill in your values

# --- Mode ---
# "local" = Ollama Gemma 2B (offline, no API key needed)
# "cloud" = Gemini API Gemma (online, requires GEMINI_API_KEY)
LLM_MODE=cloud

# --- Cloud LLM (required if LLM_MODE=cloud) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=gemma-2.5-flash

# --- Speech-to-Text Mode ---
# "local" = faster-whisper (offline, no API key)
# "cloud" = Google Cloud Speech-to-Text (supports Yoruba, Hausa, Pidgin)
STT_MODE=local
# Required if STT_MODE=cloud
GOOGLE_STT_API_KEY=your_google_cloud_api_key_here

# --- Database ---
# Option A: SQLite (default, no setup needed, great for local dev)
USE_SQLITE=true

# Option B: Supabase PostgreSQL (production-ready)
# Set USE_SQLITE=false and provide connection details
# USE_SQLITE=false
# SUPA_PASS=your_database_password
# SUPA_HOST=db.xxxxx.supabase.co
# SUPA_PORT=5432
# SUPA_DB=postgres
# SUPA_USER=postgres

# Option C: Standard PostgreSQL via DATABASE_URL
# DATABASE_URL=postgresql://user:pass@host:5432/db

# --- Auth ---
# Change this to a long random string in production
JWT_SECRET=marketguard-dev-secret-key-change-in-production
