# Railway Backend Deployment
# Set these in Railway dashboard → Variables tab

# --- Mode ---
LLM_MODE=cloud

# --- Gemini API (Gemma) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=gemma-2.5-flash

# --- Database (Supabase PostgreSQL) ---
USE_SQLITE=false
SUPA_PASS=your_supabase_password_here
SUPA_HOST=db.xxxxx.supabase.co
SUPA_PORT=5432
SUPA_DB=postgres
SUPA_USER=postgres

# --- Auth ---
JWT_SECRET=your_random_secret_key_here_make_it_32_chars_min

# --- Cloud Speech-to-Text (optional) ---
STT_MODE=cloud
GOOGLE_STT_API_KEY=your_google_stt_api_key_here
